  <question type="multichoice">
    <name><text>NEET_UG_BIOLOGY_CH11_DIAGRAM_Q05 - Simple stirred-tank bioreactor components</text></name>
    <questiontext format="html"><text><![CDATA[
      <p>Identify the functions of the parts labeled <strong>X</strong> and <strong>Y</strong> in the simple stirred-tank bioreactor shown below.</p>
      <p>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 280" width="360" height="280">
          <rect x="10" y="10" width="340" height="260" rx="8" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5"/>
          <rect x="130" y="65" width="100" height="160" rx="14" fill="#fef08a" stroke="#334155" stroke-width="2"/>
