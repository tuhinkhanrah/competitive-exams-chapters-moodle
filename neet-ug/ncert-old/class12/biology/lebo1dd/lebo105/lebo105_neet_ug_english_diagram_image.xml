    <answer fraction="0" format="html"><text><![CDATA[<p>Autosomal dominant trait</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>X-linked dominant trait</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>Y-linked trait</p>]]></text></answer>
    <answer fraction="100" format="html"><text><![CDATA[<p>Autosomal recessive trait</p>]]></text></answer>
