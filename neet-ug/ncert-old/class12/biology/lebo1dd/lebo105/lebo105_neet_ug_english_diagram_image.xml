    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html"><text><![CDATA[<p>\(WW\)</p>]]></text></answer>
    <answer fraction="100" format="html"><text><![CDATA[<p>\(Ww\)</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>\(ww\)</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>\(WWww\)</p>]]></text></answer>
