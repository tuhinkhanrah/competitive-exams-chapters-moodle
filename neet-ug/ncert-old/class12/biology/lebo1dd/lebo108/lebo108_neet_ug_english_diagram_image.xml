  <question type="multichoice">
    <name><text>NEET_UG_BIOLOGY_HUMANHEALTHANDDISEASE_DIAGRAM_Q04 - Skeletal structures and receptors of abused drugs</text></name>
    <questiontext format="html"><text><![CDATA[
      <p>Identify the two plant-derived drugs represented by the skeletal chemical structures <strong>I</strong> and <strong>II</strong>, along with their primary target receptors in the human body.</p>
      <p>
        <svg viewBox="0 0 500 220" width="500" height="220" xmlns="http://www.w3.org/2000/svg" style="background:#ffffff;border:1px solid #d9d9d9;">
          <!-- Structure I: Morphine -->
          <text x="115" y="25" font-size="14" font-weight="bold" text-anchor="middle" font-family="Arial, sans-serif">I</text>
          <!-- Benzene ring -->
          <polygon points="85,55 115,40 145,55 145,88 115,103 85,88" fill="none" stroke="#111" stroke-width="1.8"/>
          <circle cx="115" cy="71" r="14" fill="none" stroke="#111" stroke-width="1.2" stroke-dasharray="3,2"/>
          <!-- Phenolic OH -->
          <line x1="85" y1="55" x2="62" y2="42" stroke="#111" stroke-width="1.8"/>
          <text x="35" y="43" font-size="12" font-family="Arial, sans-serif">HO</text>
          <!-- Ether bridge -->
          <line x1="85" y1="88" x2="68" y2="112" stroke="#111" stroke-width="1.8"/>
          <text x="54" y="122" font-size="12" font-family="Arial, sans-serif">O</text>
