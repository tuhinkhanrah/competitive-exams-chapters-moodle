  <answernumbering>abc</answernumbering>
  <answer fraction="0" format="html"><text><![CDATA[<p><strong>X:</strong> \(CH_4, O_2, N_2, H_2O\); <strong>Y:</strong> Nucleotides and polypeptides</p>]]></text></answer>
  <answer fraction="100" format="html"><text><![CDATA[<p><strong>X:</strong> \(CH_4, NH_3, H_2, H_2O\); <strong>Y:</strong> Amino acids</p>]]></text></answer>
  <answer fraction="0" format="html"><text><![CDATA[<p><strong>X:</strong> \(CO_2, NH_3, O_2, H_2\); <strong>Y:</strong> Amino acids</p>]]></text></answer>
  <answer fraction="0" format="html"><text><![CDATA[<p><strong>X:</strong> \(CH_4, CO_2, N_2, H_2O\); <strong>Y:</strong> Polysaccharides and lipids</p>]]></text></answer>
