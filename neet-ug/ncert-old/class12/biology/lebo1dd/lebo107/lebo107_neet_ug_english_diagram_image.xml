  <answer fraction="100" format="html"><text><![CDATA[<p><strong>X:</strong> Birds; <strong>Y:</strong> Mammals</p>]]></text></answer>
  <answer fraction="0" format="html"><text><![CDATA[<p><strong>X:</strong> Mammals; <strong>Y:</strong> Birds</p>]]></text></answer>
  <answer fraction="0" format="html"><text><![CDATA[<p><strong>X:</strong> Amphibians; <strong>Y:</strong> Birds</p>]]></text></answer>
