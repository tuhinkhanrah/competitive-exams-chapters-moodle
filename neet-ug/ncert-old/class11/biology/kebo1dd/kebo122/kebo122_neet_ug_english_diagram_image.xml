    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html"><text><![CDATA[<p><strong>H<sub>1</sub>:</strong> Cortisol; <strong>H<sub>2</sub>:</strong> Insulin</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p><strong>H<sub>1</sub>:</strong> Estrogen; <strong>H<sub>2</sub>:</strong> Glucagon</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p><strong>H<sub>1</sub>:</strong> Testosterone; <strong>H<sub>2</sub>:</strong> Epinephrine</p>]]></text></answer>
    <answer fraction="100" format="html"><text><![CDATA[<p><strong>H<sub>1</sub>:</strong> Follicle stimulating hormone (FSH); <strong>H<sub>2</sub>:</strong> Estrogen</p>]]></text></answer>
