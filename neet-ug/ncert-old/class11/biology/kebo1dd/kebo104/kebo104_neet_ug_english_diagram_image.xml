    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html"><text><![CDATA[<p>P: Nerve cord, Q: Notochord, R: Gill slits, S: Post-anal part</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>P: Notochord, Q: Nerve cord, R: Gill slits, S: Post-anal part</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>P: Nerve cord, Q: Notochord, R: Nephridia, S: Proboscis</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>P: Dorsal heart, Q: Stomochord, R: Gill slits, S: Post-anal part</p>]]></text></answer>
