    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0" format="html"><text><![CDATA[<p><strong>P</strong>: \(\text{FADH}_2\), <strong>Q</strong>: \(\text{NADH} + \text{H}^+\), <strong>R</strong>: Ethanol, <strong>S</strong>: Lactic acid</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p><strong>P</strong>: \(\text{NADH} + \text{H}^+\), <strong>Q</strong>: \(\text{FADH}_2\), <strong>R</strong>: Lactic acid, <strong>S</strong>: Acetyl CoA</p>]]></text></answer>
    <answer fraction="100" format="html"><text><![CDATA[<p><strong>P</strong>: \(\text{NADH} + \text{H}^+\), <strong>Q</strong>: \(\text{NADH} + \text{H}^+\), <strong>R</strong>: Lactic acid, <strong>S</strong>: Ethanol</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p><strong>P</strong>: \(\text{NADP}^+\), <strong>Q</strong>: \(\text{NADPH}\), <strong>R</strong>: Ethanol, <strong>S</strong>: Lactic acid</p>]]></text></answer>
