    <answer fraction="0" format="html"><text><![CDATA[<p>Sodium (\(\mathrm{Na}\)); Yellow</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>Rubidium (\(\mathrm{Rb}\)); Red violet</p>]]></text></answer>
    <answer fraction="100" format="html"><text><![CDATA[<p>Potassium (\(\mathrm{K}\)); Violet</p>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<p>Lithium (\(\mathrm{Li}\)); Crimson red</p>]]></text></answer>
