  <text x="130" y="225" text-anchor="middle" font-size="11" font-weight="bold" fill="#33691e">Daughter Nucleus</text>
  <!-- Right Daughter Nucleus reforming -->
  <circle cx="270" cy="160" r="45" fill="#fff9c4" stroke="#fbc02d" stroke-width="2" stroke-dasharray="4,2"/>
  <circle cx="280" cy="150" r="10" fill="#f57f17"/>
  <text x="270" y="225" text-anchor="middle" font-size="11" font-weight="bold" fill="#33691e">Daughter Nucleus</text>
  <!-- Cell plate growing from centre outwards (P) -->
  <g>
    <!-- Phragmoplast vesicles fusing -->
    <ellipse cx="200" cy="160" rx="6" ry="40" fill="#ffb74d" stroke="#e65100" stroke-width="2"/>
    <ellipse cx="200" cy="115" rx="5" ry="12" fill="#ffb74d" stroke="#e65100" stroke-width="1.5"/>
    <ellipse cx="200" cy="205" rx="5" ry="12" fill="#ffb74d" stroke="#e65100" stroke-width="1.5"/>
