  <rect x="188" y="145" width="24" height="30" fill="#ffffff" stroke="#e65100" stroke-width="1.5" rx="4"/>
  <text x="200" y="166" text-anchor="middle" font-size="16" font-weight="bold" fill="#b71c1c">P</text>
  <!-- Lateral Wall label Q -->
  <text x="365" y="165" text-anchor="middle" font-size="16" font-weight="bold" fill="#1b5e20">Q</text>
  <line x1="352" y1="160" x2="340" y2="160" stroke="#1b5e20" stroke-width="2" marker-end="url(#arr-left)"/>
