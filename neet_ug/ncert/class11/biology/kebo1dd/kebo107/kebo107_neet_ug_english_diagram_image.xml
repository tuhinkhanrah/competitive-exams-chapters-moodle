  <ellipse cx="220" cy="318" rx="8" ry="4" fill="#4e342e"/>
  <path d="M 180 325 C 160 345, 190 360, 220 340 C 250 360, 280 345, 260 325 Z" fill="#fff9c4" stroke="#fbc02d" stroke-width="1.5"/>
