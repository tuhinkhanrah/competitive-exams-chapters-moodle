  <path d="M 105 230 L 95 240 M 105 230 L 100 245 M 105 230 L 110 245 M 105 230 L 118 240" stroke="#2d572c" stroke-width="3" stroke-linecap="round"/>
  <path d="M 330 160 C 370 140, 420 180, 390 225 C 370 245, 320 245, 290 240" fill="none" stroke="#2d572c" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M 290 240 L 255 242 M 290 240 L 258 248 M 290 240 L 265 253 M 290 240 L 275 256 M 290 240 L 285 256" stroke="#2d572c" stroke-width="3" stroke-linecap="round"/>
  <polygon points="255,242 258,248 265,253 275,256 285,256 290,240" fill="#aed581" opacity="0.6"/>
