    <answer fraction="0" format="html">
      <text><![CDATA[<p>A &ndash; Liver, B &ndash; Stomach, C &ndash; Rectum, D &ndash; Urinary bladder</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A &ndash; Gall bladder, B &ndash; Pancreas, C &ndash; Intestine, D &ndash; Cloaca</p>]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A &ndash; Gall bladder, B &ndash; Stomach, C &ndash; Intestine, D &ndash; Cloaca</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A &ndash; Lung, B &ndash; Stomach, C &ndash; Intestine, D &ndash; Urinary bladder</p>]]></text>
    </answer>
