    <answer fraction="0" format="html">
      <text><![CDATA[<p>A &ndash; Adrenal gland, B &ndash; Vasa efferentia, C &ndash; Ureter, D &ndash; Urinary bladder</p>]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>A &ndash; Testis, B &ndash; Vasa efferentia, C &ndash; Urinogenital duct, D &ndash; Cloaca</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A &ndash; Testis, B &ndash; Bidder's canal, C &ndash; Oviduct, D &ndash; Cloaca</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>A &ndash; Fat body, B &ndash; Vasa efferentia, C &ndash; Urinogenital duct, D &ndash; Rectum</p>]]></text>
    </answer>
