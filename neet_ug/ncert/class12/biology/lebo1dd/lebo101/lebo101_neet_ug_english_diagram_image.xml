    <answer fraction="0" format="html">
      <text><![CDATA[<p>P = Synergids, Q = Polar nuclei, R = Central cell, S = Filiform apparatus</p>]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>P = Antipodals, Q = Polar nuclei, R = Egg cell, S = Filiform apparatus</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>P = Antipodals, Q = Central cell, R = Synergid, S = Micropyle</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>P = Polar nuclei, Q = Antipodals, R = Egg cell, S = Filiform apparatus</p>]]></text>
    </answer>
