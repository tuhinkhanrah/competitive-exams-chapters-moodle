    <answer fraction="100" format="html">
      <text><![CDATA[<p>[ X ] = Meiosis, [ Y ] = Mitosis, [ Z ] = Parthenogenesis</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>[ X ] = Mitosis, [ Y ] = Meiosis, [ Z ] = Parthenogenesis</p>]]></text>
    </answer>
