    <answer fraction="0" format="html">
      <text><![CDATA[<p>Homozygous dominant (\(WW\)); reciprocal cross</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Homozygous dominant (\(WW\)); test cross</p>]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Heterozygous (\(Ww\)); test cross</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Heterozygous (\(Ww\)); back cross yielding all dominant offspring</p>]]></text>
    </answer>
