    <answer fraction="0" format="html">
      <text><![CDATA[<p>Inert pair effect preventing the loss of outermost \(s\)-electrons in the \(5d\) series.</p>]]></text>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>Lanthanoid contraction caused by the poor shielding effect of intervening \(4f\) orbitals.</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Complete quenching of orbital angular momentum in the heavy transition metals.</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Drastic decrease in effective nuclear charge along the \(5d\) transition elements.</p>]]></text>
    </answer>
